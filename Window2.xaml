<Window x:Class="OOPWPFProject.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Window2"
        Height="600"
        Width="800">
    <Window.Resources>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2228"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E333A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#252A31"/>
            <Setter Property="AlternatingRowBackground" Value="#20252B"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E333A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        
        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#252A31"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A404A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A5668"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <ImageBrush x:Key="MENU2" ImageSource="MENU2.png"/>
        <Style x:Key="Font_style" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Resources/Roboto/Roboto-Light.ttf"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="tt_stl" TargetType="ToolTip">
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
            <Setter Property="Background" Value="#4A5668"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Resources/Roboto/Roboto-Light.ttf #Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlacementRectangle" Value="60,0,0,0"/>
            <Setter Property="HorizontalOffset" Value="15"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Mennu2" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Borders"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Borders" Value="{StaticResource MENU2}"/>
                                <Setter Property="BorderBrush" TargetName="Borders" Value="{StaticResource MENU2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="Borders" Value="{StaticResource MENU2}"/>
                                <Setter Property="BorderBrush" TargetName="Borders" Value="{StaticResource MENU2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuItem_Style" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="Orders"
              HorizontalAlignment="Left"
              Width="65"
              Background="#2E333A">
            <StackPanel>
                <Grid Height="65">
                    <TextBlock Margin="73,0,0,0"
                               Text="М Е Н Ю"
                               Style="{StaticResource Font_style}"
                               FontSize="22"/>
                    <ToggleButton x:Name="Button_mENU"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="18,0,0,0"
                                  Height="30" Width="30"
                                  BorderThickness="0"
                                  Style="{StaticResource Mennu2}">
                        <ToggleButton.Background>
                            <ImageBrush ImageSource="MENU.png" Stretch="UniformToFill"/>
                        </ToggleButton.Background>
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Orders"
                                                         Storyboard.TargetProperty="Width"
                                                         From="230" To="65"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Orders"
                                                         Storyboard.TargetProperty="Width"
                                                         From="65" To="230"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Grid>

                <ListView x:Name="OrdList"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OrdList_SelectionChanged">
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image Source="/Buymenu.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Товари" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Товари" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image Source="/Orderssssss.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Замовлення" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Замовлення" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image Source="/Order.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Корзина" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Корзина" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image x:Name="loginpng" Source="/login.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock x:Name="LoginTxt" Text="Увійти" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Увійти" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image Source="/Exit.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Вийти" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Вийти" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    
                    
                </ListView>
            </StackPanel>
        </Grid>

        <Grid Margin="65,0,0,0">
            <Grid x:Name="Tovary" Visibility="Collapsed" Background="#1E2228">
                <TextBlock Text="Товари" Foreground="White" FontSize="24" Margin="20"/>
                <DataGrid x:Name="TovarGrid" SelectionChanged="selectAmount"
          Style="{StaticResource ModernDataGrid}" 
          AutoGenerateColumns="True" Width="500" IsReadOnly="True" Margin="20" RowHeight="40" ColumnHeaderHeight="40" Height="200"/>
                <ComboBox Visibility="Collapsed" x:Name="AmountCombo" Height="45" FontSize="16" Margin="0,300,0,0" Width="100"/>
                <Button Visibility="Collapsed" x:Name="AddOrder" Content="Додати замолення в кошик"    Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,400,0,0" Width="300" Click="AddOrder_Click"/>
                <Button Visibility="Collapsed" x:Name="Delete"  Click="Delete_Click" Content="Видалити товари" Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,500,0,0" Width="300"/>
            </Grid>
            <Grid x:Name="Zamovlennya" Visibility="Collapsed" Background="#1E2228">

                <TextBlock Text="Замовлення" Foreground="White" FontSize="24" Margin="20"/>
                <DataGrid x:Name="OrdersList" Style="{StaticResource ModernDataGrid}" 
AutoGenerateColumns="True" Width="500" IsReadOnly="True" Margin="20" RowHeight="40" ColumnHeaderHeight="40" Height="200"/>
            </Grid>
            <Grid x:Name="basket" Visibility="Collapsed" Background="#4A5668">
                <TextBlock Text="Кошик" Foreground="White" FontSize="24" Margin="20"/>
                <DataGrid x:Name="BasketGrid"
Style="{StaticResource ModernDataGrid}" 
AutoGenerateColumns="True" Width="500" IsReadOnly="True" Margin="20" RowHeight="40" ColumnHeaderHeight="40" Height="200"/>
                <Button x:Name="AddOrders" Content="Додати замолення в кошик"    Background="#4A5668" Foreground="White"
BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,400,0,0" Width="300" Click="AddOrders_Click"/>
            </Grid>
            <Grid x:Name="Login" Visibility="Collapsed" Background="#1E2228">
                
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <StackPanel x:Name="Logins">
                        <RadioButton x:Name="l" Content="Увійти в аккаунт" Checked="l_Checked" FontSize="25"/>
                        <RadioButton x:Name="r" Content="Створити аккаунт" Checked="r_Checked" Background="White" Foreground="#CE93D8" FontSize="25"/>
                        <TextBlock x:Name="EmailTxt" Text="Email" Foreground="#aaaaaa" FontSize="13" Margin="0,0,0,5" Visibility="Collapsed"/>
                        <TextBox x:Name="Email" Background="#2E333A" Foreground="White"
                                 BorderBrush="#4A5668" Height="40" FontSize="15" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtPass"  Text="Пароль" Foreground="#aaaaaa" FontSize="13" Margin="0,0,0,5" Visibility="Collapsed"/>
                        <PasswordBox x:Name="Password" Background="#2E333A" Foreground="White"
                                     BorderBrush="#4A5668" Height="40" FontSize="15" Margin="0,0,0,20" Visibility="Collapsed"/>
                        <TextBlock x:Name="NumTxt" Text="Введіть номер телефону" Foreground="#aaaaaa" FontSize="13" Margin="0,0,0,5" Visibility="Collapsed"/>
                        <TextBox x:Name="Numbe" Background="#2E333A" Foreground="White"
              BorderBrush="#4A5668" Height="40" FontSize="15" Margin="0,0,0,20" Visibility="Collapsed"/>
                        <TextBlock x:Name="Name_FnameTxt" Text="Введіть ваше ім'я та прізвище" Foreground="#aaaaaa" FontSize="13" Margin="0,0,0,5" Visibility="Collapsed"/>
                        <TextBox x:Name="Name_Fname" Background="#2E333A" Foreground="White"
BorderBrush="#4A5668" Height="40" FontSize="15" Margin="0,0,0,20" Visibility="Collapsed"/>
                        <Button x:Name="Log" Content="Увійти" Background="#4A5668" Foreground="White"
                                BorderBrush="Transparent" Height="45" FontSize="16" Click="Log_Click" Visibility="Collapsed"/>
                        <Button x:Name="Reg" Content="Створити аккаунт" Background="#4A5668" Foreground="White"
          BorderBrush="Transparent" Height="45" FontSize="16" Click="Reg_Click" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock x:Name="Exit" Foreground="Red" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
                   <Grid x:Name="Profile" Visibility="Collapsed" Background="#1E2228">
             
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
               <TextBlock Text="Профіль" Foreground="White" FontSize="24" Margin="0,0,0,20"/>
               <TextBlock x:Name="ProfileEmail" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,10"/>
               <TextBlock x:Name="ProfileName" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,10"/>
               <TextBlock x:Name="ProfileNumber" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,20"/>
               <Button x:Name="exitAcc" Content="Вийти з акаунту" Click="exitAcc_Click"  
   Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16"/>
           </StackPanel>
                <Button x:Name="addTovar" Click="addTovar_Click" 
        Background="#4A5668" Foreground="White"
        BorderBrush="Transparent" Height="45" FontSize="16" 
        Visibility="Collapsed" Content="Додати товар"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Stretch"
        Margin="20,0,20,20"/>
            </Grid>
        </Grid>
        
    </Grid>
</Window>