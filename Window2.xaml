<Window x:Class="OOPWPFProject.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPWPFProject"
        mc:Ignorable="d"
        Title="Window2"
        Height="600"
        Width="800">
    <Window.Resources>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2228"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E333A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#252A31"/>
            <Setter Property="AlternatingRowBackground" Value="#20252B"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E333A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>


        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="#252A31"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A404A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A5668"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <ImageBrush x:Key="MENU2" ImageSource="/Photos/MENU2.png"/>
        <Style x:Key="Font_style" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Resources/Roboto/Roboto-Light.ttf"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="tt_stl" TargetType="ToolTip">
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="30,0,0,0"/>
            <Setter Property="Background" Value="#4A5668"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Resources/Roboto/Roboto-Light.ttf #Roboto"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PlacementRectangle" Value="60,0,0,0"/>
            <Setter Property="HorizontalOffset" Value="15"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Mennu2" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Borders"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Borders" Value="{StaticResource MENU2}"/>
                                <Setter Property="BorderBrush" TargetName="Borders" Value="{StaticResource MENU2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="Borders" Value="{StaticResource MENU2}"/>
                                <Setter Property="BorderBrush" TargetName="Borders" Value="{StaticResource MENU2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuItem_Style" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="Orders" Panel.ZIndex="999"
              HorizontalAlignment="Left"
              Width="65"
              Background="#2E333A">
            <StackPanel>
                <Grid Height="65">
                    <TextBlock Margin="73,0,0,0"
                               Text="М Е Н Ю"
                               Style="{StaticResource Font_style}"
                               FontSize="22"/>
                    <ToggleButton x:Name="Button_mENU"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="18,0,0,0"
                                  Height="30" Width="30"
                                  BorderThickness="0"
                                  Style="{StaticResource Mennu2}">
                        <ToggleButton.Background>
                            <ImageBrush ImageSource="/Photos/MENU.png" Stretch="UniformToFill"/>
                        </ToggleButton.Background>
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Orders"
                                                         Storyboard.TargetProperty="Width"
                                                         From="230" To="65"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Orders"
                                                         Storyboard.TargetProperty="Width"
                                                         From="65" To="230"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Grid>

                <ListView x:Name="OrdList" Visibility="Visible"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OrdList_SelectionChanged">
                    <ListViewItem x:Name="TovarCour" Visibility="Visible" Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50" x:Name="BuyMenu" Visibility="Collapsed">
                            <Image Source="/Photos/Buymenu.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Товари" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Товари" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem  Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50" x:Name="OrdersPhoto"  Visibility="Collapsed">
                            <Image Source="/Photos/Orderssssss.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Замовлення" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Замовлення" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem x:Name="BasketCour" Visibility="Visible" Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50" x:Name="BusketPhoto"  Visibility="Collapsed">
                            <Image Source="/Photos/Order.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Корзина" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip >
                            <ToolTip Content="Корзина" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image x:Name="loginpng" Source="/Photos/login.png" Stretch="None" Width="30" Margin="17,0,0,0" RenderTransformOrigin="43.234,6.531"/>
                            <TextBlock x:Name="LoginTxt" Text="Увійти" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Увійти" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>
                    <ListViewItem Visibility="Visible" Style="{StaticResource MenuItem_Style}">
                        <StackPanel Orientation="Horizontal" Width="230" Height="50">
                            <Image Source="/Photos/Exit.png" Stretch="None" Width="30" Margin="17,0,0,0"/>
                            <TextBlock Text="Вийти" Margin="18,0,0,0" Style="{StaticResource Font_style}"/>
                        </StackPanel>
                        <ListViewItem.ToolTip>
                            <ToolTip Content="Вийти" Style="{StaticResource tt_stl}"/>
                        </ListViewItem.ToolTip>
                    </ListViewItem>


                </ListView>
            </StackPanel>
        </Grid>

        <Grid Margin="65,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="207*"/>
                <RowDefinition Height="377*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Tovary" Visibility="Collapsed" Background="#1E2228" Grid.RowSpan="2">
                <TextBlock Text="Товари" Foreground="White" FontSize="24" Margin="20"/>
                <StackPanel x:Name="StackSearch" Orientation="Horizontal"  Margin="500,-400,0,0" Visibility="Collapsed">
                    <TextBox x:Name="SearchName"  materialDesign:HintAssist.Hint="пошук" Padding="0" FontSize="15" Foreground="Black"  Background="white" Width="150" VerticalAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Height="40"   Style="{StaticResource MaterialDesignFilledTextBox}" />
                    <Button x:Name="SearchButton" Content="🔎" Height="40" Click="SearchButton_Click"/>
                    
                </StackPanel>
                <ComboBox x:Name="SearchCategori" Visibility="Collapsed" SelectionChanged="SearchCategori_Selected" Background="White" Height="55" Width="150" materialDesign:HintAssist.Hint="Категорія" Margin="0,-400,0,0" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="Їжа"/>
                    <ComboBoxItem Content="Напої"/>
                    <ComboBoxItem Content="Інше"/>
                    <ComboBoxItem Content="Усі"/>
                </ComboBox>
                <DataGrid x:Name="TovarGridOf" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" RowHeight="100" HorizontalScrollBarVisibility="Hidden" Height="300" Margin="20,60,20,80" SelectionChanged="selectAmount">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва товару"  Width="160" Binding="{Binding [NameProduct]}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="Ціна"  Width="80" Binding="{Binding [Price]}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Категорія" Width="120" Binding="{Binding [Categori]}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Кількість" Width="170" Binding="{Binding [Amount]}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn  Header="Фото" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Width="90" Height="90" ClipToBounds="True">

                                        <Image Source="{Binding [PhotoProduct]}" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
                
                <ComboBox Visibility="Collapsed"  x:Name="AmountCombo" Height="40" FontSize="16" Margin="0,300,0,0" Width="150" Background="White" materialDesign:HintAssist.Hint="Виберіть кількість"/>
                <Button Visibility="Collapsed" x:Name="AddOrder" Content="Додати замолення в кошик"    Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,400,0,0" Width="300" Click="AddOrder_Click"/>
                <Button Visibility="Collapsed" x:Name="Delete"  Content="Видалити товари" Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,500,0,0" Width="300" Click="Delete_Click"/>
            </Grid>
            <Grid x:Name="Zamovlennya" Visibility="Collapsed" Background="#1E2228" Grid.RowSpan="2">


                <TextBlock Text="Замовлення" Foreground="White" FontSize="24" Margin="20"/>
                <TextBox x:Name="SearchNameOrder" Background="White" Width="150" Height="40" Visibility="Collapsed" Margin="260,-250,0,0" materialDesign:HintAssist.Hint="Введіть назву для пошуку"/>
                <Button x:Name="SearchButtonName" Margin="460,-251,0,0" Height="40" Width="50" Visibility="Collapsed" Content="🔎" Click="SearchButtonName_Click"/>
                <DataGrid x:Name="OrdersList" SelectionChanged="OrdersList_SelectionChanged" Style="{StaticResource ModernDataGrid}" 
AutoGenerateColumns="True" Width="500" IsReadOnly="True" Margin="20" RowHeight="40" ColumnHeaderHeight="40" Height="200"/>
                <ComboBox Visibility="Collapsed" materialDesign:HintAssist.Hint="Змінити статус"  x:Name="StatusS" Width="165" Height="30" Margin="0,300,0,0" Background="White"/>
                <Button Visibility="Collapsed" x:Name="StatusSButton" Content="Змінити статус" Background="#4A5668" Foreground="White"
   BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,400,0,0" Width="300" Click="StatusSButton_Click" />
                <Button x:Name="DeleteOrder" Margin="0,300,0,0" Content="Видалити замовлення" Width="200" Click="DeleteOrder_Click" Visibility="Collapsed"/>
                <ComboBox Visibility="Collapsed" x:Name="SortPrice" Margin="0,-250,0,0" Height="40" SelectionChanged="SortPrice_SelectionChanged" Background="White" Width="100" materialDesign:HintAssist.Hint="Sort Price">
                    <ComboBoxItem Content="Спочатку дешевші"/>
                    <ComboBoxItem Content="Спочатку дорожчі"/>
                    <ComboBoxItem Content="Усі"/>
                </ComboBox>
                <Button Visibility="Collapsed" x:Name="ButtonInfoCourier" Margin="0,400,0,0" Content="Дані кур'єра" Width="200" Click="ButtonInfoCourier_Click"/>
            </Grid>
            <Grid x:Name="basket" Visibility="Collapsed" Background="#1E2228" Grid.RowSpan="2">
                <TextBlock Text="Кошик" Foreground="Black" FontSize="24" Margin="20"/>
                <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Foreground="White"  Margin="0,100,0,0"/>

                <DataGrid x:Name="BasketGrid"
Style="{StaticResource ModernDataGrid}" 
                          
                          
AutoGenerateColumns="True" Width="500" IsReadOnly="True" Margin="20" RowHeight="40" ColumnHeaderHeight="40" Height="200"/>

                <StackPanel  x:Name="CityD" >

                    <ComboBox Visibility="Collapsed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="Місто доставки"  Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="18" x:Name="CityDelivery" Foreground="Black" Background="White" SelectionChanged="CityDelivery_SelectionChanged"  Width="200" Height="57" Margin="0,400,500,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Житомир"/>
                        <ComboBoxItem Content="Львів"/>
                        <ComboBoxItem Content="Київ"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,400,0,0" x:Name="DeliveryStace" Visibility="Collapsed">

                    <StackPanel  x:Name="AddressD" Margin="250,10,0,0"  >

                        <ComboBox  x:Name="AdressDelivery" Width="180" Background="White" FontSize="18" Height="57" materialDesign:HintAssist.Hint="Оберіть адресу" Foreground="Black"  Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,-10,0,0"/>
                    </StackPanel>

                   
                </StackPanel>

                <StackPanel  x:Name="paymnetStack" Visibility="Collapsed"  Orientation="Horizontal" Margin="0,400,0,0"  >
                    <RadioButton  x:Name="CartPayment" Foreground="White" Content="Оплата балансом" Height="20" Margin="0,10,0,0"   Style="{StaticResource MaterialDesignRadioButton}"/>
                    <RadioButton  x:Name="MoneyPayment" Foreground="White" Content="Оплата готівкою" Style="{StaticResource MaterialDesignRadioButton}" Height="20" Margin="0,10,0,0"/>
                </StackPanel>


                <Button Visibility="Collapsed" x:Name="AddOrders" Content="Оформити замовлення!"    Background="Green" Foreground="White"
BorderBrush="Transparent" Height="45" FontSize="16" Margin="20,420,0,0" Width="250" Click="AddOrders_Click"/>
            </Grid>
            <Grid x:Name="Login" Visibility="Collapsed" Background="#1E2228" Grid.RowSpan="2">
                <Border Width="420"
                        
        Height="520"
        Background="White"
        CornerRadius="20"
        Opacity="0.95"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
                    <TextBlock Text="Увійдіть / Створіть аккаунт" FontSize="16" Foreground="Black" Margin="100,50,0,0"/>

                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    
                    <StackPanel x:Name="Logins" Orientation="Vertical" Margin="0,100,0,0 ">
                        <RadioButton x:Name="l" GroupName="MyGroup"
                     Content="Увійти в аккаунт"
                     Checked="l_Checked"
                     Foreground="DarkOrchid"
                     Margin="0,8"
                     Style="{StaticResource MaterialDesignRadioButton}"/>

                        <RadioButton x:Name="r" GroupName="MyGroup"
                     Content="Створити аккаунт"
                     Checked="r_Checked"
                     Foreground="DarkOrchid"
                     Margin="0,8"
                     Style="{StaticResource MaterialDesignRadioButton}"/>

                        <RadioButton x:Name="C" GroupName="MyGroup"
                     Content="Увійти як кур'єр"
                     Checked="c_Checked"
                     Foreground="DarkOrchid"
                     Margin="0,8"
                     Style="{StaticResource MaterialDesignRadioButton}"/>
                    </StackPanel>
                    <TextBox x:Name="Email" FontSize="15"
             Visibility="Collapsed"
             Height="45"
             Margin="0,0,0,15"
             materialDesign:HintAssist.Hint="Введіть почту"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <PasswordBox x:Name="Password" FontSize="15" KeyDown="Password_KeyDown"
                 Visibility="Collapsed"
                 Height="45"
                 Margin="0,0,0,15" materialDesign:HintAssist.Hint="Введіть пароль" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>

                    <TextBox x:Name="Numbe"
            FontSize="15"
         Visibility="Collapsed"
         Height="45"
         Margin="0,0,0,15"
         VerticalContentAlignment="Center"
         materialDesign:HintAssist.Hint="Введіть номер телефону"
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <TextBox x:Name="Name_Fname" FontSize="15" KeyDown="Name_Fname_KeyDown"
             Visibility="Collapsed"
             Height="45"
             Margin="0,0,0,15"
             materialDesign:HintAssist.Hint="Введіть ім'я та прізвище" VerticalContentAlignment="Center"  Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <TextBox x:Name="Code" FontSize="15"
             Visibility="Collapsed"
             Height="45"
             Margin="0,0,0,20"
             materialDesign:HintAssist.Hint="Введіть код кур'єра" VerticalContentAlignment="Center"  Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <Button x:Name="Log"
            Content="Увійти"
            Background="#7C4DFF"
            Foreground="White"
            Height="45" FontSize="16" BorderBrush="Transparent" Click="Log_Click" Visibility="Collapsed"/>

                    <Button x:Name="Reg"
            Content="Створити аккаунт"
            Background="#7C4DFF"
            Foreground="White"
            Height="45"
            FontSize="16"
            BorderBrush="Transparent"
            Click="Reg_Click"
            Visibility="Collapsed"/>

                    <Button x:Name="LogCourier"
            Content="Увійти як кур'єр"
            Background="#7C4DFF"
            Foreground="White"
            Height="45"
            FontSize="16"
            BorderBrush="Transparent"
            Click="LogCourier_Click"
            Visibility="Collapsed"/>

                    <TextBlock x:Name="Exit"
               Foreground="#FF5252"
               FontSize="14"
               HorizontalAlignment="Center"
               Margin="0,15,0,0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="Profile" Visibility="Collapsed" Background="#1E2228" Grid.RowSpan="2">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <TextBlock Text="Профіль" Foreground="White" FontSize="24" Margin="0,0,0,20"/>
                    <TextBlock x:Name="ProfileEmail" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ProfileName" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ProfileNumber" Foreground="#aaaaaa" FontSize="16" Margin="0,0,0,20"/>
                    <TextBlock x:Name="BalanceText"
FontSize="16"
Foreground="White"
HorizontalAlignment="Center"
Margin="0,0,0,0"/>
                    <Button Visibility="Collapsed" x:Name="Deposit" Content="Поповнити баланс" Click="Deposit_Click"/>
                    <Button x:Name="exitAcc" Content="Вийти з акаунту"  Click="exitAcc_Click"  
Background="#4A5668" Foreground="Red"
BorderBrush="Transparent" Height="45" FontSize="16" Margin="0,30,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,100">
                    <Button x:Name="addTovar" Click="addTovar_Click" 
        Background="BlueViolet"  Foreground="White"
        BorderBrush="Transparent" Height="40" FontSize="16" 
        Visibility="Collapsed" Content="Додати товар"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Stretch"
        Margin="20,0,1,20"/>
                    <Button x:Name="AddCourier" Click="AddCourier_Click" 
Background="BlueViolet"  Foreground="White"
BorderBrush="Transparent" Height="40" FontSize="16" 
Visibility="Collapsed" Content="Додати кур'єра"
VerticalAlignment="Bottom"
HorizontalAlignment="Stretch"
Margin="20,0,1,20"/>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>