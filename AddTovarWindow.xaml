<Window x:Class="OOPWPFProject.AddTovarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:OOPWPFProject" mc:Ignorable="d" Title="Система обліку замовлень" Height="1000" Width="1200">
    <Window.Resources>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2228"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E333A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#252A31"/>
            <Setter Property="AlternatingRowBackground" Value="#20252B"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E333A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>


        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Background" Value="#252A31"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A404A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A5668"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Background" Value="MediumOrchid"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        
    </Window.Resources>
    <Grid Background="Gray">
        <Border MinWidth="400" Margin="15" Background="White" VerticalAlignment="Center" Padding="30" MaxWidth="800" CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="OrangeRed" ShadowDepth="0"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Додайте замовлення" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Назва товару"/>
                    <TextBox x:Name="nameTovar"/>
                    <TextBlock Text="Ціна"/>
                    <TextBox x:Name="priceTovar"/>
                    <TextBlock Text="Категорії"/>
                    <ComboBox  x:Name="categoriTovar">
                        <ComboBoxItem Content="Їжа"/>
                        <ComboBoxItem Content="Напої"/>
                        <ComboBoxItem Content="Інше"/>
                    </ComboBox>
                    <TextBlock Text="Кількість"/>
                    <TextBox x:Name="amountTovar"/>
                    
                
                    <TextBlock Text="Фото"/>
                    
                    <StackPanel Orientation="Horizontal">



                        <TextBox x:Name="photoTovar"  Width="700" Height="40"  Margin="0,10,0,0"/>
                        <Button x:Name="PhotoS" Content="🔗" Height="40"  Style="{StaticResource Button}" Click="PhotoButton_Click" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Grid>
                        <Button x:Name="AddTovar" Content="Додати товар" MinWidth="10" MaxWidth="200" Style="{StaticResource Button}" Click="AddTovar_Click"/>
                        
                    </Grid>
                    <DataGrid x:Name="TovarGrid" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" RowHeight="100" HorizontalScrollBarVisibility="Hidden" SelectionChanged="TovarGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Назва товару"  Width="160" Binding="{Binding [NameProduct]}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ціна"  Width="80" Binding="{Binding [Price]}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Категорія" Width="120" Binding="{Binding [Categori]}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Кількість" Width="170" Binding="{Binding [Amount]}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn  Header="Фото" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Width="90" Height="90" ClipToBounds="True">

                                            <Image Source="{Binding [PhotoProduct]}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        
                    </DataGrid>

                    <Grid>
                        <Button x:Name="Delete_tovar" Content="Видалити товар🗑️" Style="{StaticResource Button}" Width="125" Click="Delete_tovar_Click"/>
                        <Button x:Name="Edit_tovar" Content="Редагувати товар📝" Style="{StaticResource Button}" HorizontalAlignment="Left" Width="145" Click="Edit_tovar_Click"/>
                    </Grid>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>