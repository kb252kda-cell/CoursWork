<Window x:Class="OOPWPFProject.RegistCourier" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:OOPWPFProject" mc:Ignorable="d" Title="Система обліку замовлень" Height="1000" Width="1200">
    <Window.Resources>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Background" Value="MediumOrchid"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="10"/>

        </Style>
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2228"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E333A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#252A31"/>
            <Setter Property="AlternatingRowBackground" Value="#20252B"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E333A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A404A"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>


        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Background" Value="#252A31"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A404A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A5668"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>
    <Grid Background="Gray">
        <Border MinWidth="400" Margin="15" Background="White" VerticalAlignment="Center" Padding="30" MaxWidth="900" CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="OrangeRed" ShadowDepth="0"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Реєстрація кур'єра" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Прізвище та Ім'я"/>
                    <TextBox x:Name="fmaim_nameCour"/>
                    <TextBlock Text="Вік"/>
                    <TextBox x:Name="ageCour"/>
                    <TextBlock Text="Стать"/>
                    <ComboBox  x:Name="GenderCour">
                        <ComboBoxItem Content="Чоловік"/>
                        <ComboBoxItem Content="Жінка"/>
                    </ComboBox>
                    <TextBlock Text="Номер"/>
                    <TextBox x:Name="Number"/>
                    <TextBlock Text="Фото"/>
                    <StackPanel Orientation="Horizontal">



                        <TextBox x:Name="Photo1"  Width="800" Height="40"  Margin="0,10,0,0"/>
                        <Button x:Name="PhotoButton" Content="🔗" Height="40"  Style="{StaticResource Button}" Click="PhotoButton_Click" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Text="Місто" />
                    <ComboBox x:Name="cityCour">
                        <ComboBoxItem Content="Житомир"/>
                        <ComboBoxItem Content="ЛЬвів"/>
                        <ComboBoxItem Content="Київ"/>
                    </ComboBox>
                    <TextBlock Text="Код"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CodeCourier" Width="100" Margin="0,10,0,0"/>
                        <Button x:Name="GenerationCode" Margin="0,10,0,0" Content="Згенерувати код" Style="{StaticResource Button}" Click="GenerationCode_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130*"/>
                            <ColumnDefinition Width="535*"/>
                            <ColumnDefinition Width="29*"/>
                            <ColumnDefinition Width="146*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RegistrCourier" Content="Зар'єструвати кур'єра" MinWidth="10" MaxWidth="200" Style="{StaticResource Button}" Click="RegistrCourier_Click" Grid.ColumnSpan="4" Margin="10,10,10,10"/>
                    </Grid>
                    <DataGrid x:Name="CourierGrid" AutoGenerateColumns="False" Style="{StaticResource ModernDataGrid}" RowHeight="70">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Прізвище та ім'я" Binding="{Binding [ElementName]}" Width="*"/>
                            <DataGridTextColumn  Header="Вік" Binding="{Binding [ageCourier]}" Width="80"/>
                            <DataGridTextColumn Header="Стать"  Binding="{Binding [GenderCourier]}"  Width="120"/>
                            <DataGridTextColumn Header="Номер" Binding="{Binding [numberCourier]}" Width="170"/>
                            <DataGridTemplateColumn  Header="Фото" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Width="55" Height="55" ClipToBounds="True">

                                            <Image Source="{Binding [photoCourier]}" Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Місто"  Binding="{Binding [cityCourier]}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>